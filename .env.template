# --- SerpApi (Google Search) ---
SERPAPI_API_KEY=your_serpapi_key_here

# --- Gemini (Agentic Critic) ---
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# --- Google Sheets ---
# Path to the service-account JSON file (download from Google Cloud Console).
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Either provide a sheet ID (preferred) or the visible sheet name.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Live Performance Tracker
GOOGLE_WORKSHEET_NAME=Performances

# --- Scheduler / App ---
SWEEP_TIMES=09:00,21:00          # comma-separated 24h local times
TZ=America/New_York
SQLITE_PATH=./tracker.db

# --- Web ---
HOST=0.0.0.0
PORT=5000
