modules = ["python-3.11", "web"]
run = "python run.py"
hidden = [".config", ".git", "__pycache__", ".venv", "venv", "tracker.db"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["pip", "install", "-r", "requirements.txt"]
run = ["python", "run.py"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install -r requirements.txt && python run.py"
waitForPort = 5000
